# LLM endpoint. Two modes:
#  A) Local dev proxy (works with ANY endpoint, no CORS): set VITE_LLM_BASE_URL=/llm
#     and put the real endpoint in LLM_PROXY_TARGET below. Vite forwards /llm/* → target.
#  B) Direct (endpoint must send CORS headers): set VITE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VITE_LLM_BASE_URL=/llm
LLM_PROXY_TARGET=https://open.bigmodel.cn/api/paas/v4

# API key for the endpoint above
VITE_LLM_KEY=

# Model id, e.g. glm-5.3-flash / glm-4.6 / deepseek-chat / gpt-4o …
VITE_LLM_MODEL=glm-5.3-flash

# Extra headers some gateways require (JSON). Example for opencode.ai zen:
# VITE_LLM_EXTRA_HEADERS={"x-opencode-session":"<id>"}

# --- server-side proxies (read by vite.config.ts, never bundled to the browser) ---
# Jupiter quote proxy — hosted API is mainnet-only since devnet was retired.
JUP_PROXY_TARGET=https://lite-api.jup.ag
# Local HTTP(S) proxy for outbound hosts blocked on this network (e.g. Clash on 7890).
# Leave empty for direct connections.
LOCAL_HTTPS_PROXY=
